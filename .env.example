# Copy this file to .env and adjust values for your machine.
# NEVER commit the real .env file.

# PostgreSQL — the project's database. Create a dedicated DB + user first
# (don't use the postgres superuser here), e.g.:
#   CREATE USER hrms_app WITH PASSWORD '...';
#   CREATE DATABASE staunch_hrms OWNER hrms_app;
DATABASE_URL=postgresql+psycopg2://hrms_app:CHANGE_ME@localhost:5432/staunch_hrms

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-every-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ICICI Composite Pay API (bulk salary disbursement) — all blank until your
# ICICI relationship manager provides real onboarding credentials. Leaving
# these blank is safe: the icici_bulk_salary_txt_v1 bank file format still
# generates, only the live API submit/status endpoints are disabled (they
# return 503 with instructions). See app/services/icici_api/client.py.
ICICI_API_KEY=
ICICI_CORP_ID=
ICICI_USER_ID=
ICICI_AGGR_ID=
ICICI_AGGR_NAME=
ICICI_URN=
# UAT sandbox by default — do not point at the LIVE URL until real
# credentials and a confirmed go-live date exist.
ICICI_BASE_URL=https://apibankingonesandbox.icicibank.com
# Set True only once your RM confirms UAT requires the encrypted envelope
# AND ICICI_RSA_PUBLIC_KEY_PEM / ICICI_RSA_PRIVATE_KEY_PEM below are set.
ICICI_ENCRYPTION_ENABLED=False
ICICI_RSA_PUBLIC_KEY_PEM=
ICICI_RSA_PRIVATE_KEY_PEM=
